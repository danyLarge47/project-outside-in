      contentRows:
      - Row_Type: NodeStart
        Row_Notes: 'Conditions: $wholeProgress == 2 && $mom_flag == 2.'
        Row_Id: OI_Mom_Resolve_Final_Ending
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L01
        Args_1: '[PlayerName]'
        Args_2: Aku ngerti Mama khawatir.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L02
        Args_1: '[PlayerName]'
        Args_2: Tapi kalau aku lagi kesulitan, aku butuh Mama dengerin dulu sebelum marah.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L03
        Args_1: Mom
        Args_2: Mama cuma nggak mau kamu kenapa-kenapa.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L04
        Args_1: '[PlayerName]'
        Args_2: Aku tahu. Hari ini berat, dan aku pengin bisa cerita.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L05
        Args_1: Mom
        Args_2: ...ya sudah. Kamu istirahat dulu.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L06
        Args_1: '[PlayerName]'
        Args_2: Makasih, Ma.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Transition
        Row_Notes: Gambar kamar dan tableau spirit noninteraktif; bukan gameplay baru.
        Row_Id: 
        Args_1: CrossFade
        Args_2: 0.7
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L07
        Args_1: Inner Voice
        Args_2: Words can still hurt.
        Args_3: inner
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L08
        Args_1: Inner Voice
        Args_2: I can still be afraid.
        Args_3: inner
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L09
        Args_1: Inner Voice
        Args_2: "But I don\u2019t have to disappear."
        Args_3: inner
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L10
        Args_1: Inner Voice
        Args_2: I can listen.
        Args_3: inner
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L11
        Args_1: Inner Voice
        Args_2: I can feel.
        Args_3: inner
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L12
        Args_1: Inner Voice
        Args_2: I can choose what stays.
        Args_3: inner
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Mom_Resolve_Final_Ending_L13
        Args_1: Inner Voice
        Args_2: "And I can speak when I\u2019m ready."
        Args_3: inner
        Args_4: 
        Args_5: 
      - Row_Type: DialogueEnd
        Row_Notes: 
        Row_Id: 
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
