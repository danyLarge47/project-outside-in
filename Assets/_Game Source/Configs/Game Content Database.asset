    value:
      Id: OI_School_Mira_Between_Issues
      contentRows:
      - Row_Type: NodeStart
        Row_Notes: 'Conditions: $wholeProgress == 1 && $inner_area == 0 && $friend_a_flag != 1 && $friend_b_flag != 1 && $friend_c_flag != 1 && $lastIssue > 0 && $miraLastIssue == $lastIssue && ($friend_a_flag == 0 || $friend_b_flag == 0 || $friend_c_flag == 0).'
