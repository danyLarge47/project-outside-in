      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_B_Issue_Unlock_Area2_L04
        Args_1: '[PlayerName]'
        Args_2: Aku belum selesai ngomong.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_B_Issue_Unlock_Area2_L05
        Args_1: Classmate B
        Args_2: Kamu terlalu sensitif. Aku cuma bilang.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_B_Issue_Unlock_Area2_L06
