  interactions_database:
  - key: Map_Home
    value:
      Id: Map_Home
      interactionRows:
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $wholeProgress == 0
        Content_ID: OI_Map_Home_First_Pick
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $wholeProgress == 2
        Content_ID: OI_Map_Home_Return
  - key: Map_School
    value:
      Id: Map_School
      interactionRows:
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $wholeProgress == 1
        Content_ID: OI_Map_School_First_Day
  - key: School_Classmate_A
    value:
      Id: School_Classmate_A
      interactionRows:
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: 
        Content_ID: OI_School_A_Issue_Unlock_Area1
  - key: School_Classmate_B
    value:
      Id: School_Classmate_B
      interactionRows:
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: 
        Content_ID: OI_School_B_Issue_Unlock_Area2
  - key: School_Classmate_C
    value:
      Id: School_Classmate_C
      interactionRows:
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: 
        Content_ID: OI_School_C_Issue_Unlock_Area3
  - key: School_Mira
    value:
      Id: School_Mira
      interactionRows:
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $wholeProgress == 1 && $inner_area == 0 && $friend_a_flag != 1 && $friend_b_flag != 1 && $friend_c_flag != 1 && $lastIssue == 1 && $friend_a_flag == 2 && $miraLastIssue != 1
        Content_ID: OI_School_Mira_Empathy_Reveal
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $wholeProgress == 1 && $inner_area == 0 && $friend_a_flag != 1 && $friend_b_flag != 1 && $friend_c_flag != 1 && $lastIssue == 2 && $friend_b_flag == 2 && $miraLastIssue != 2
        Content_ID: OI_School_Mira_Help_Boundary
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $wholeProgress == 1 && $inner_area == 0 && $friend_a_flag != 1 && $friend_b_flag != 1 && $friend_c_flag != 1 && $lastIssue == 3 && $friend_c_flag == 2 && $miraLastIssue != 3
        Content_ID: OI_School_Mira_Help_Process
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $wholeProgress == 1 && $inner_area == 0 && $friend_a_flag != 1 && $friend_b_flag != 1 && $friend_c_flag != 1 && $lastIssue > 0 && $miraLastIssue == $lastIssue && ($friend_a_flag == 0 || $friend_b_flag == 0 || $friend_c_flag == 0)
        Content_ID: OI_School_Mira_Between_Issues
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $wholeProgress == 1 && $inner_area == 0 && $friend_a_flag == 2 && $friend_b_flag == 2 && $friend_c_flag == 2 && $miraLastIssue == $lastIssue
        Content_ID: OI_School_Mira_Walk_Home_Thank_You
  - key: Home_Mom
    value:
      Id: Home_Mom
      interactionRows:
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $wholeProgress == 0
        Content_ID: OI_Mom_Morning_Exit_To_Map
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $wholeProgress == 2 && $mom_flag == 0
        Content_ID: OI_Mom_Conflict_Unlock_Combined
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $wholeProgress == 2 && $mom_flag == 1
        Content_ID: OI_Mom_InnerWorld_Pending
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $wholeProgress == 2 && $mom_flag == 2
        Content_ID: OI_Mom_Resolve_Final_Ending
  - key: Inner_World
    value:
      Id: Inner_World
      interactionRows:
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $friend_a_flag == 1
        Content_ID: OI_InnerWorld_Area1
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $friend_b_flag == 1
        Content_ID: OI_InnerWorld_Area2
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $friend_c_flag == 1
        Content_ID: OI_InnerWorld_Area3
      - Row_Type: Interaction
        Interaction_Id: 
        Conditions: $mom_flag == 1
        Content_ID: OI_InnerWorld_Combined_Breakthrough
  content_database:
  - key: OI_Map_Home_First_Pick
    value:
      Id: OI_Map_Home_First_Pick
      contentRows:
      - Row_Type: NodeStart
        Row_Notes: 'Conditions: $wholeProgress == 0.'
        Row_Id: OI_Map_Home_First_Pick
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: Transition
        Row_Notes: Controller memilih scene sesuai phase map; bukan perubahan scene otomatis dari nama ID.
        Row_Id: 
        Args_1: CrossFade
        Args_2: 0.6
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: PlayAMB
        Row_Notes: Usulan asset ID; petakan ke aset audio. Suara rumah pagi dan lalu lintas jauh.
        Row_Id: 
        Args_1: amb_home_morning
        Args_2: Replace
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Map_Home_First_Pick_L01
        Args_1: Narator
        Args_2: Sebelum hari pertamaku di sekolah baru dimulai, aku masih harus melewati pagi di rumah.
        Args_3: narration
        Args_4: 
        Args_5: 
      - Row_Type: DialogueEnd
        Row_Notes: 
        Row_Id: 
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: NodeEnd
        Row_Notes: Controller memuat Home; progres dan flag tidak direset. Tampilkan Mom.
        Row_Id: 
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
  - key: OI_Map_Home_Return
    value:
      Id: OI_Map_Home_Return
      contentRows:
      - Row_Type: NodeStart
        Row_Notes: 'Conditions: $wholeProgress == 2.'
        Row_Id: OI_Map_Home_Return
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: Transition
        Row_Notes: Controller memilih scene sesuai phase map; bukan perubahan scene otomatis dari nama ID.
        Row_Id: 
        Args_1: CrossFade
        Args_2: 0.6
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Map_Home_Return_L01
        Args_1: Narator
        Args_2: Percakapan tadi masih terasa hangat.
        Args_3: narration
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Map_Home_Return_L02
        Args_1: Narator
        Args_2: Aku berharap bisa membawa sedikit keberanian itu pulang.
        Args_3: narration
        Args_4: 
        Args_5: 
      - Row_Type: DialogueEnd
        Row_Notes: 
        Row_Id: 
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: NodeEnd
        Row_Notes: Controller memuat Home; progres dan flag tidak direset. Tampilkan Mom.
        Row_Id: 
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
  - key: OI_Map_School_First_Day
    value:
      Id: OI_Map_School_First_Day
      contentRows:
      - Row_Type: NodeStart
        Row_Notes: 'Conditions: $wholeProgress == 1.'
        Row_Id: OI_Map_School_First_Day
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: Transition
        Row_Notes: Controller memilih scene sesuai phase map; bukan perubahan scene otomatis dari nama ID.
        Row_Id: 
        Args_1: CrossFade
        Args_2: 0.6
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: PlayAMB
        Row_Notes: Usulan asset ID; petakan ke aset audio. Percakapan kelas pelan dan kursi.
        Row_Id: 
        Args_1: amb_school
        Args_2: Replace
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: PlayBGM
        Row_Notes: Usulan asset ID; petakan ke aset audio. Motif sekolah yang ragu dan ringan.
        Row_Id: 
        Args_1: bgm_school
        Args_2: Replace
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Map_School_First_Day_L01
        Args_1: Narator
        Args_2: Hari pertama di sekolah ini. Semuanya masih asing.
        Args_3: narration
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Map_School_First_Day_L02
        Args_1: Guru
        Args_2: Teman-teman, hari ini ada teman baru. Kamu boleh kenalin diri dulu.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Map_School_First_Day_L03
        Args_1: '[PlayerName]'
        Args_2: Hai... aku [PlayerName].
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Map_School_First_Day_L04
        Args_1: Guru
        Args_2: Selamat datang. Kamu bisa duduk di sebelah sana.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_Map_School_First_Day_L05
        Args_1: Narator
        Args_2: Empat wajah yang belum kukenal. Aku bahkan belum tahu harus mulai bicara dengan siapa.
        Args_3: narration
        Args_4: 
        Args_5: 
      - Row_Type: DialogueEnd
        Row_Notes: 
        Row_Id: 
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: NodeEnd
        Row_Notes: Controller memuat School. Mainkan intro hanya pada first entry; revisits tidak reset flag. A/B/C tampil jika flag masing-masing 0. Mira memakai Conditions; tombol Inner_World aktif jika ada flag 1.
        Row_Id: 
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
  - key: OI_School_A_Issue_Unlock_Area1
    value:
      Id: OI_School_A_Issue_Unlock_Area1
      contentRows:
      - Row_Type: NodeStart
        Row_Notes: Satu interaksi; Conditions kosong. Hotspot hanya aktif saat flag karakter 0. Dialog membuka issue, tetap di School.
        Row_Id: OI_School_A_Issue_Unlock_Area1
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_A_Issue_Unlock_Area1_L01
        Args_1: Classmate A
        Args_2: Kamu pendiem banget, ya?
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_A_Issue_Unlock_Area1_L02
        Args_1: '[PlayerName]'
        Args_2: Aku cuma... belum tahu mau ngomong apa.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_A_Issue_Unlock_Area1_L03
        Args_1: Classmate A
        Args_2: Oh. Kirain emang nggak mau ngobrol.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_A_Issue_Unlock_Area1_L04
        Args_1: Inner Voice
