  - key: OI_School_Mira_Empathy_Reveal
    value:
      Id: OI_School_Mira_Empathy_Reveal
      contentRows:
      - Row_Type: NodeStart
        Row_Notes: 'Conditions: $wholeProgress == 1 && $inner_area == 0 && $friend_a_flag != 1 && $friend_b_flag != 1 && $friend_c_flag != 1 && $lastIssue == 1 && $friend_a_flag == 2 && $miraLastIssue != 1.'
        Row_Id: OI_School_Mira_Empathy_Reveal
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: PlayBGM
        Row_Notes: Usulan asset ID; petakan ke aset audio. Piano hangat tanpa nuansa kemenangan besar.
        Row_Id: 
        Args_1: bgm_mira
        Args_2: Replace
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_Mira_Empathy_Reveal_L01
        Args_1: Mira
        Args_2: Kamu oke?
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_Mira_Empathy_Reveal_L02
        Args_1: '[PlayerName]'
        Args_2: Iya.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_Mira_Empathy_Reveal_L03
        Args_1: Mira
        Args_2: Oke. Aku nggak akan maksa.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Wait
        Row_Notes: Jeda memberi ruang.
        Row_Id: 
        Args_1: 1
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_Mira_Empathy_Reveal_L04
        Args_1: Mira
        Args_2: Tapi kalau mau duduk di sini, duduk aja.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_Mira_Empathy_Reveal_L05
        Args_1: Mira
        Args_2: Hari pertama emang capek.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_Mira_Empathy_Reveal_L06
        Args_1: '[PlayerName]'
        Args_2: Kelihatan banget ya?
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_Mira_Empathy_Reveal_L07
        Args_1: Mira
        Args_2: Sedikit. Aku dulu juga begitu.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_Mira_Empathy_Reveal_L08
        Args_1: '[PlayerName]'
        Args_2: Aku takut mereka mikir aku aneh.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_Mira_Empathy_Reveal_L09
        Args_1: Mira
        Args_2: Aku juga pernah merasa begitu. Kadang aku perlu tanya dulu sebelum tahu maksud orang.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_Mira_Empathy_Reveal_L10
        Args_1: '[PlayerName]'
        Args_2: Aku nggak harus langsung menganggap diriku aneh.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: Dialogue
        Row_Notes: 
        Row_Id: OI_School_Mira_Empathy_Reveal_L11
        Args_1: Mira
        Args_2: Iya. Kamu boleh butuh waktu.
        Args_3: neutral
        Args_4: 
        Args_5: 
      - Row_Type: DialogueEnd
        Row_Notes: 
        Row_Id: 
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: SetVar
        Row_Notes: Issue yang sudah dibahas dengan Mira; friend flag tetap 2.
        Row_Id: 
        Args_1: miraLastIssue
        Args_2: 1
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: SetVar
        Row_Notes: 
        Row_Id: 
        Args_1: ally_revealed
        Args_2: 1
        Args_3: 
        Args_4: 
        Args_5: 
      - Row_Type: NodeEnd
        Row_Notes: Refresh interaksi; wholeProgress dan friend flags tetap. Mira tidak memiliki dialog sebelum ada issue selesai.
        Row_Id: 
        Args_1: 
        Args_2: 
        Args_3: 
        Args_4: 
        Args_5: 
